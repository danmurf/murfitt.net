---
interface Props {
  id: string;
}

const { id } = Astro.props;
const embedUrl = `https://player.vimeo.com/video/${id}`;
---

<div class="not-prose my-6 aspect-video w-full overflow-hidden rounded-lg border border-ink-800">
  <iframe
    src={embedUrl}
    title="Vimeo video"
    class="size-full"
    allow="autoplay; fullscreen; picture-in-picture"
    allowfullscreen
    loading="lazy"
  ></iframe>
</div>