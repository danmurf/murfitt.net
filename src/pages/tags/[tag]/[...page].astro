---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPublishedPosts, getAllTags, slugifyTag } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = await getAllTags(posts);
  return [...tags.entries()].map(([tag, tagPosts]) => ({
    params: { tag: slugifyTag(tag) },
    props: { tag, posts: tagPosts },
  }));
}

interface Props {
  tag: string;
  posts: any[];
}

const { tag, posts } = Astro.props;
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title={`Posts tagged "${tag}"`}>
  <h1 class="mb-8 text-2xl font-bold text-ink-100">
    <span class="font-mono text-ink-500">#</span>{tag}
  </h1>
  <div class="divide-y divide-ink-800 border-y border-ink-800">
    {sorted.map((post) => <PostCard post={post} />)}
  </div>
</Base>