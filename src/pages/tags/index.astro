---
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, getAllTags, tagUrl } from '../../lib/posts';

const posts = await getPublishedPosts();
const tags = await getAllTags(posts);
const sorted = [...tags.entries()].sort((a, b) => b[1].length - a[1].length);
---

<Base title="Tags">
  <h1 class="mb-8 text-2xl font-bold text-ink-100">Tags</h1>
  <ul class="flex flex-wrap gap-3">
    {
      sorted.map(([tag, tagPosts]) => (
        <li>
          <a href={tagUrl(tag)} class="tag-pill">
            {tag}
            <span class="ml-1 text-ink-600">{tagPosts.length}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>