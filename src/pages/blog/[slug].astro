---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const now = new Date();
  return posts
    .filter((p) => p.data.date <= now)
    .map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, tags, description, cover } = post.data;

const isRemote = (src: string) => src.startsWith('http') || src.startsWith('//');
const coverImage = cover?.image;
const isStringSrc = typeof coverImage === 'string';
const isBundleImage = !!coverImage && !isStringSrc;

const ogImage = !coverImage
  ? undefined
  : isStringSrc && !isRemote(coverImage as string)
    ? undefined
    : isStringSrc
      ? (coverImage as string)
      : new URL((coverImage as { src: string }).src, Astro.site).toString();
---

<Base
  title={title}
  description={description}
  image={ogImage}
  type="article"
  publishedTime={date}
  tags={tags}
>
  <article>
    <header class="mb-8">
      <h1 class="text-2xl font-bold leading-tight text-ink-100 sm:text-3xl">{title}</h1>
      <p class="meta mt-2">
        <time datetime={date.toISOString()}>{new Intl.DateTimeFormat('en-GB', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
          timeZone: 'UTC',
        }).format(date)}</time>
      </p>
      {tags.length > 0 && <div class="mt-3"><Tags tags={tags} /></div>}
    </header>

    {
      cover && !cover.hiddenInSingle && coverImage && (
        <figure class="mb-8">
          {isBundleImage ? (
            <Image
              src={coverImage}
              alt={cover.alt ?? title}
              widths={[480, 960, 1440]}
              sizes="(max-width: 672px) 100vw, 672px"
              format="webp"
              class="w-full rounded-lg border border-ink-800"
              loading="eager"
            />
          ) : (
            <img
              src={coverImage as string}
              alt={cover.alt ?? title}
              class="mb-0 w-full rounded-lg border border-ink-800"
              loading="eager"
            />
          )}
          {cover.caption && (
            <figcaption class="mt-2 text-center text-sm text-ink-500">{cover.caption}</figcaption>
          )}
        </figure>
      )
    }

    <div class="prose prose-invert max-w-none prose-headings:font-semibold prose-a:break-words prose-img:rounded-lg">
      <Content />
    </div>
  </article>
</Base>