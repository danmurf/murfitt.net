---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, type Post } from '../../lib/posts';
import { POSTS_PER_PAGE } from '../../lib/site';

export async function getStaticPaths({ paginate }: { paginate: (items: Post[], opts: any) => any[] }) {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: POSTS_PER_PAGE });
}

interface Props {
  page: any;
}

const { page } = Astro.props;
---

<Base title="Blog">
  <h1 class="mb-8 text-2xl font-bold text-ink-100">Blog</h1>
  <div class="divide-y divide-ink-800 border-y border-ink-800">
    {page.data.map((post: Post) => <PostCard post={post} />)}
  </div>

  {
    page.url.prev || page.url.next ? (
      <nav class="mt-8 flex justify-between font-mono text-sm" aria-label="Pagination">
        {page.url.prev ? (
          <a href={page.url.prev} class="no-underline">
            &larr; Newer
          </a>
        ) : (
          <span />
        )}
        {page.url.next ? (
          <a href={page.url.next} class="no-underline">
            Older &rarr;
          </a>
        ) : (
          <span />
        )}
      </nav>
    ) : null
  }

  <p class="meta mt-10">
    <a href="/index.xml" class="no-underline">RSS</a>
  </p>
</Base>