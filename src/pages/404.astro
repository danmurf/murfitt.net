---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="py-20 text-center">
    <p class="font-mono text-6xl font-bold text-accent-400">404</p>
    <p class="mt-4 text-ink-400">The page you're looking for doesn't exist.</p>
    <p class="mt-6">
      <a href="/">Back to the homepage</a>
    </p>
  </div>
</Base>